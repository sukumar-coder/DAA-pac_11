n = int(input("Enter number of vertices: "))

print("Enter adjacency matrix (use 999 for no edge):")

dist = []

for i in range(n):
    row = list(map(int, input().split()))
    dist.append(row)

for k in range(n):
    for i in range(n):
        for j in range(n):
            dist[i][j] = min(dist[i][j],
                             dist[i][k] + dist[k][j])

print("Shortest distance matrix:")

for row in dist:
    print(row)
